FROM golang:1.26-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /openfga-witness ./cmd/witness/

FROM alpine:3.23
RUN apk --no-cache add ca-certificates
COPY --from=builder /openfga-witness /usr/local/bin/openfga-witness
ENTRYPOINT ["openfga-witness"]
CMD ["run"]
